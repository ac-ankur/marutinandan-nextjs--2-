# Public site URL used for metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.marutinandan.in

# Google Analytics 4 Measurement ID (leave blank to disable GA)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Password required to access /admin (defaults to "marutinandan2026" if unset)
ADMIN_PASSWORD=change-this-password

# Resend contact-form email. Set FROM to an address on a domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_TO_EMAIL=yugikafoods@gmail.com
RESEND_FROM_EMAIL="Yugika Foods <onboarding@resend.dev>"

# Backend API URL (Yugika Foods API)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google OAuth Client ID for Continue with Google (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
